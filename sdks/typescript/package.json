{
  "name": "@nimbus-dev/sdk",
  "version": "1.29.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimbus-agent/nimbus-sdk.git",
    "directory": "sdks/typescript"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "bun": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./ipc": {
      "bun": "./src/ipc/index.ts",
      "types": "./dist/ipc/index.d.ts",
      "import": "./dist/ipc/index.js",
      "default": "./dist/ipc/index.js"
    },
    "./connector-kit": {
      "bun": "./src/connector-kit/index.ts",
      "types": "./dist/connector-kit/index.d.ts",
      "import": "./dist/connector-kit/index.js",
      "default": "./dist/connector-kit/index.js"
    },
    "./diagnostics": {
      "bun": "./src/diagnostics/index.ts",
      "types": "./dist/diagnostics/index.d.ts",
      "import": "./dist/diagnostics/index.js",
      "default": "./dist/diagnostics/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "api:surface": "bun run build && bun run scripts/api-surface.ts",
    "conformance:coverage": "bun run scripts/conformance-coverage.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ scripts/ examples/",
    "test": "bun test",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build && bun run typecheck"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "^1.4.0",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  }
}
