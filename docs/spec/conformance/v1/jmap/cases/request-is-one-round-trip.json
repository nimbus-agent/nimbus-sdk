{
  "description": "list is two method calls in one request",
  "kind": "request",
  "form": "list",
  "accountId": "u1",
  "limit": 5,
  "expect": {
    "request": {
      "using": [
        "urn:ietf:params:jmap:core",
        "urn:ietf:params:jmap:mail"
      ],
      "methodCalls": [
        [
          "Email/query",
          {
            "accountId": "u1",
            "sort": [
              {
                "property": "receivedAt",
                "isAscending": false
              }
            ],
            "collapseThreads": false,
            "limit": 5
          },
          "q"
        ],
        [
          "Email/get",
          {
            "accountId": "u1",
            "#ids": {
              "resultOf": "q",
              "name": "Email/query",
              "path": "/ids"
            },
            "properties": [
              "id",
              "blobId",
              "threadId",
              "subject",
              "from",
              "to",
              "cc",
              "receivedAt",
              "sentAt",
              "messageId",
              "hasAttachment",
              "preview",
              "attachments",
              "textBody",
              "bodyValues"
            ],
            "fetchTextBodyValues": true,
            "maxBodyValueBytes": 2048,
            "bodyProperties": [
              "partId",
              "blobId",
              "size",
              "name",
              "type",
              "disposition"
            ]
          },
          "e"
        ]
      ]
    }
  }
}
