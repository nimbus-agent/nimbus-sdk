{
  "fixtures": [
    {
      "file": "manifest/valid-minimal.json",
      "shape": "ExtensionManifest",
      "expect": "valid",
      "class": "equivalence",
      "violations": [],
      "reason": "Every required field present and well-formed."
    },
    {
      "file": "manifest/valid-runtime-python.json",
      "shape": "ExtensionManifest",
      "expect": "valid",
      "class": "equivalence",
      "violations": [],
      "reason": "A Python connector can declare its runtime honestly. runtime: \"python\" was invalid before RFC-0009 widened manifest.runtime.enum; it is now accepted by both the schema and runContractTests."
    },
    {
      "file": "manifest/valid-prerelease-min-version.json",
      "shape": "ExtensionManifest",
      "expect": "valid",
      "class": "equivalence",
      "violations": [],
      "reason": "minNimbusVersion is unanchored at the end, so a prerelease suffix is accepted."
    },
    {
      "file": "manifest/valid-leading-space-min-version.json",
      "shape": "ExtensionManifest",
      "expect": "valid",
      "class": "equivalence",
      "violations": [],
      "reason": "Blank characters are removed from both ends of minNimbusVersion before matching."
    },
    {
      "file": "manifest/valid-unknown-extra-key.json",
      "shape": "ExtensionManifest",
      "expect": "valid",
      "class": "equivalence",
      "violations": [],
      "reason": "Neither the schema nor the rules set additionalProperties: false, so an undeclared extra key must still validate on both sides. Pins the manifest schema's openness."
    },
    {
      "file": "manifest/valid-zero-width-space-id.json",
      "shape": "ExtensionManifest",
      "expect": "valid",
      "class": "equivalence",
      "violations": [],
      "reason": "U+200B ZERO WIDTH SPACE is not Unicode White_Space, so an id consisting of one is not blank. Invisible, but a character. Pins the lower edge of the blank set."
    },
    {
      "file": "manifest/invalid-missing-id.json",
      "shape": "ExtensionManifest",
      "expect": "invalid",
      "class": "equivalence",
      "violations": [{ "rule": "manifest.id.required", "path": "/id" }],
      "reason": "id is required."
    },
    {
      "file": "manifest/invalid-whitespace-id.json",
      "shape": "ExtensionManifest",
      "expect": "invalid",
      "class": "equivalence",
      "violations": [{ "rule": "manifest.id.required", "path": "/id" }],
      "reason": "id must contain a character outside the blank set."
    },
    {
      "file": "manifest/invalid-nel-only-id.json",
      "shape": "ExtensionManifest",
      "expect": "invalid",
      "class": "equivalence",
      "violations": [{ "rule": "manifest.id.required", "path": "/id" }],
      "reason": "U+0085 NEL is Unicode White_Space, so an id of one is blank — though JavaScript's trim uniquely leaves it in place. Pins the upper edge of the blank set, and the reason the schema pattern cannot be a bare \\S."
    },
    {
      "file": "manifest/invalid-missing-display-name.json",
      "shape": "ExtensionManifest",
      "expect": "invalid",
